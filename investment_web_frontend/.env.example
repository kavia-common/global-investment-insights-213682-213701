# Frontend environment configuration
# IMPORTANT: Do not commit actual secrets. Copy to .env and fill in values locally.
# CRA automatically exposes variables prefixed with REACT_APP_

# Base URL for the investment API backend (e.g., http://localhost:8000 or full HTTPS URL)
REACT_APP_API_BASE_URL=http://localhost:8000

# Site URL for auth email redirects (set to the deployed site URL)
REACT_APP_SITE_URL=http://localhost:3000

# Optional: Feature flags
REACT_APP_FEATURE_SUGGESTIONS=true
REACT_APP_FEATURE_PORTFOLIO=true
REACT_APP_FEATURE_PRICING=true
REACT_APP_FEATURE_ONBOARDING=true
